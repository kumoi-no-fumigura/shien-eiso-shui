    219
   ],
   "text": "終",
   "poems": [],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "うはべなき醉北すさびの舞をしも鼻かき猴い物とグめせり",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "聲そへてまさたち並ぶ人もなき鳥のまひあそ花と見えけれ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "處せき山ふところいいでながら月日のか〓の猶くもりつゝ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "それとなくうつれバ變る一年を心のいろお〓めてけるかな",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "玉まきの眞かひい人のとらねどもかへる舟路に光さしつゝ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "吹すさぶ風にたぐひて人玄れぬ惠をかへすにしきなるらむ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "とみくさと雲雀いもとで家鳩はつぱさにかけしかぎ蕨かな",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "をりとらむ花をおほへる袖おあそひとの心も打なびきけき",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "諸共にうれバうるしのつやよりもましてふかはす心をりきや",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "天そゝり目にたち山し高けれバ綱いはふともよすべくもなし",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "君グもつ郁子の實一つえましかバ百の黃金も惜まざらまし",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "幽あといよそに隔てゝうつし世を獨のためしみつ比關もり",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "さ蕨のをりならねども岩そゝぐ垂水の上にこヽろすましつ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "日のあまり月比始のさとへこそ老も隱るゝはえおい有けれ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "大空に氏もあるてふ物さだめ神いあさ日のゑみてきくらし",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "ひあばえも花こそさかめ本あらの萩比古根に水そゝがまし",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "そこふかき池〓心いいくみも〓では〓しく人のいひはなつめる",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "折しもあれ垣よりもるゝ笛のねに隔てぬ中の昔をぞおもふ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "〓たり川まさりて人のかへりこび緒絶の琴をつぎ橋おせむ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "心せむたかき李の木のもとにかうぶりたヾす人もこそあれ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "ふきたちし嵐も露とうちしめる李のはないにはにちらさじ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "さ野つ鳥なれぬる里と思ひしにこもふさはしき桑のもと哉",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "おしよりも人比心しあゆかねバとらい鼠のあなさへぞゆく",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "たをやめの心うごかす影ならびさこそゑましく月いとらまし",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "ありし世い答へまうしの爭やわが耳さへおさやぎのみして",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "うらめしき風たえしより八房の梅の一ひら香こそみちけれ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "二葉よりなはく見ゆるを何に玄か兒の手柏と思ひくよしヽ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "みまからバいつへのおもの備ふべく益良猛夫の功たてばや",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "さゝきとる心のもさではやぶさのはぐくみたてし人や幾人",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "老ぬれび蒲生の若葉やはらかにまとふ車のわれをめすとり",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "これぞ世を捨し我身のうへの衣きませる君いたゞに歸さむ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "こま劔わがみすてずべ二さやの隔てし家をかへりとやせむ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "機織女おるとせしまのきり〓〓すなど徒にあきをへにけむ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "きえ殘る雪にけたれて白玉のつら〓〓つばき土におちつや",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "門とぢむ雪もとくとや風およる柳のあ〓をゆるべそめけむ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "前玄りへきほふ言葉のあやはとり春と秋とやさてぬきおせし",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "うた司みちびくうしの鈴がねもふりし車も玄るひとぞ玄る",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "水かみい遠ざかれども絹川のきよきながれお人ぞおりたつ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "たち花の地におちしも玉なるを星のかずさへ磨きいでつや",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "おりかくる花の錦い夢ならずとりのあや羽を糸ぐちにして",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "あはれまたとられし筆のつかのまふ命もたえぬ錦ならねど",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "露うけてからむとすれがいとゞしく白玉小菅靡きふしつゝ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "笠いあれど隱笠あいみ吉野の〓くまが菅ぞぬふべかりける",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "くれ竹のもとの心比一すぢをみつの小路にわけかはしつゝ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "風おなる瓢いかけじとづらはしみ山がくれの夢をさそひて",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "中々にうつしとめつる逢坂の鳥の空音いあとこそありけれ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "あとなしといひなはおちそ早くより思ひ渡せる佐野の卅橋",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "あけてこそ昔いいはめ足りなへゆるがぬ御代の寳ならずや",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "そのかみ比功によりてたてそめし門ならなくに何かまつらむ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "色なくが匂さへやいのあるべき玄ぼめる花も花おあそよれ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "くれなゐの裾ひく道も心せむうばらからたち根ざすとぞ聞く",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "ひぢ袋むかしの重荷とりかけし片輪ぐるまの跡もとヾめず",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "あれわたる駒をとゞむと老人の結びしくさい夢にとけろり",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "かざりなき姿を千代と定め義之ちぎりもこもるまつの烟か",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "天地の袋の紐やむもばましとけバぞいとぐゑえれこぼるヽ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "なげうてバ又うちかへす荒波比ひヾきを碎く玉のあゑかな",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "をりかへて共に寶やはなつべきみちひの玉〓數ならぬ身も",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "うるはしき玉祭すとよき人おとへるもさこそ樂しかりけめ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "よしといふ事こそよけれ吉野山いる月もよしさく花もよし",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "たちのぼる道をバ霧の隔てゝもなほ山なかに市なせりとか",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "さゝグにのくもの梯かけもあへずいくたびはなつ松比嵐ぞ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "時をなみひそみし龍のあや衣かけつや牛に火さへたぐへて",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "鳥だふと思のまゝになきさけぶ時てそよけれいざきほひてむ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "あら鷹の塒にふるゝ一羽ぶきぬすたつ鳥い尾羽やれおけり",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "鶯のひとく〓〓もきゝわかでよるなく子さへ厭ふその名か",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "いでさゝむ門といまだき小車のあとおも見えし雪の色かな",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "さきぬといいはねど花をとふ人のあとより繁く跡をあそとへ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "皆人の車のくさびなげすてゝとるさりづきい幾めぐりしつ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "味酒のもたひにのらバいかばかり醉のまに〓〓ふし轉ばまし",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "淵よりもふかき情にせみの羽の袖につゝめる玉やはなちし",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "それと見し姿もきゆる幻にたまのありかをいかゞたづねむ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "物思へバ文属わらはのねりもうしよみぢに往てとく仕へばや",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "心から我身い谷になげぬとも奈良の大路をやまぢといせじ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "かしましの雀のこゑや竹の實になれぬる鳥の影い見えぞて",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "むぐらして浮れ心をとざすかないでこし方にゆき隱れてむ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "かしこしとうなねいつかじ上下をたゞすの神の御前ならねバ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "中山のこ比玄た露にうちふして玄る人もなき菊のひともと",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "いとか山ありなし雲を貫きて射手の夜聲ぞやゝ玄らみゆく",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "いると見し岸い離れてをち方の弓はり月にさるさけぶなり",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "閨とちて之のびにまとふつヾりをも猶身におはぬ錦とや思ふ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "ぬれがぬるかべの內おもいさむとい君が現に今ぞ見えけむ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "天地のひまゆく駒のかげなれバめに見ぬくまも隔あらじな",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "あともりく假初ならぬ妻とひを夢野の鹿の玄るべせしかな",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "隱せとももは天地の神ぞゑる我はた玄りぬなも玄りぬべし",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "うま酒も妻もこがねも寳かいみつの濱べにみそぎあそせめ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "猴に似しすみうい遠く離れしを三度さけぶと何かこつらむ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "母子草玄げくなりにしそ〓かみの山田をろちに數へそべばや",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "舞人の入日のかげをかへす手比うはべよげなる筆づかひ哉",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "きほひろねおはれも行くりくざかけ比羽がひ比からし目ふや觸けむ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "とぶ鳥のさり羽の風お桐ならぬみつな柏ぞひと葉おちゝる",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "二見がたともに鮑のもとほれる岩ほいよらじ玉手ふるとも",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "世の塵をくゑはらゝかしふみミれがいよ〓〓雪の〓くもある哉",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "燈火をふくろに包むほどもなく螢のかげいあらはれおけり",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "縣見もうつれびかへて紫陽花比よひらの露を袖おかけつゝ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "唐にしき五つの糸のたてなれバそのを車いぬきにおらせじ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "さしかざす五重かさねの色はえてあふぎ見られし梅櫻かな",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "おも影いくりやよりいでし雲なれや繪島の浦おたてる白波",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "琴ひきと君いめせども隱ろへる芦まの蟹のつまはじきして",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "山人のすみかに見えし星の影きえて玄らるゝ名こそ高けれ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "富人のさそひたつとも我いたゞくまき酒屋に杖をといめむ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "あけざらバ常夜になしでみかのへを高ぶる神とならまし物を",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "玄るしあるふるまひならで笹蟹のいとこそなげタ母のとおめを",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "わが心まグり北池に釣せしといはずしもあらぬ憂世也とや",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "靑葉山たかき梢をあらはして恐び音そゝぐほとゝぎすかな",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "靑馬の名をバかくさじ白雪あまがへて君ハ身に玄めぬとも",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "隣までまなくかよひし涙おもあゆちの水をせれぞく〓ける",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "その皷うつ人もなし親玄たふこゑ七さとにとヾろきぬめり",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "七くさに菊をそへてもわさ萩のさき亂れたる花ぞまさらむ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "いとさしもかきな數へそ七草に菊あも玄かぬ野べの玄こ艸",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "ぬぎすてむ衣ならましを紫のはひおくれたる色お見えつゝ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "嬉しさを包めど洩てくだりゆく世おしもたつか袖の狹きに",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "はく太刀い波きるひれお益良夫の夢もまさしき舟よそひ哉",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "まき柱ふときも何の心ぞいたつれバかてにたふれ比みして",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "初瀨女が白木綿花もちりぬらし尾上比檜原かねひヾくなり",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "目おだあも五の角いたてけるをまろや何しか氏びとにせむ",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "あらましにたてし柳の庵たかみ葛城やまもなびきこそよれ",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "手束弓かへすとかけのをぞへあと矢よりも早くとき放ちけり",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "幾里かすぎぬと問へバ立花のもとほとゝぎす空おなくなり",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "うき旅にいりなむ山を造れとやくしの御神の〓へおきけむ",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "いかなれバ鳥の跡よりあらはして囀る聲を世にとヾめけむ",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "さとりあれパ二世の後もまだきよりおもかげおたつ宮柱哉",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "夢むもぶ便とときしまき〓〓のひものかざりに驚かれつゝ",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "雪深き道かいなぞものる駒の日陰ふきえむゑるべをバせし",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "わが袖をぬらすもはかな川とづに枝の雫のおちもはてなで",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "大原のゆきにあらしになれ衣つま木の道をつくさましかバ",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "玄をれても猶色かへぬ榊葉にはかなき露をかけむとやする",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "すだれのみはらむと見しをあつ衣おとなひ高し閨の秋かぜ",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "嬉しくもなか〓〓胸のあへる哉きのふにかへしけふの細布",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "風まじり雨ふる夜半のぬれ衣をもえぬ思ひにいかいほすべき",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "おぞへなき我つるばみ比洗衣くさしすつらむ綿にかへめや",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "かな山の玄め繩たえて名殘なくくづれはてぬる夢のうき橋",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "みちのくにさくときゝしを賑はしき黃金の花い都なりけり",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "おしかへす千人の聲比轟につかひぐるまいやるかたもなし",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "文車にさすや油のつきにしも日をそへてこそ語りいでけれ",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "思ふどちかさらひ山比霜つゞらひけバ崩れて朝日さすなり",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "僞りの見ゆる鏡のなかりせバ移ろふうさい玄られざらまし",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "夕づつのかゆきかくゆくいとな〓を手にまかせたる琴の調ぞ",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "同じ枝をいかにわきてり蔭深きあねはの松に霜のおくらむ",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "なき人のかねても塵に埋めぞバあらはれましやきよき心の",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "冠北かたみのほとき程もなく破れやいせぬくざけやいせぬ",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "神山のおくのすみかい求むとも時にあふひをりざしといせじ",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "久方の空より通ふあぢがもい神のみことをうけくつおこそ",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "限なき野山のものゝいつとなくたはるゝ門い老せざりけり",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "籠の中にこもれる鳥の心から跡あらはしてとびたちおけり",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "壁に見しあとふみかへて眞な柱まなび易くや〓へそめけむ",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "網の目にかけてないひそ民草の靡きよるべき風のすがたを",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "かの池のいひさわぐべき谷ならしいをねぬ人も心こそあれ",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "あけてあそいふべかりけれみぞもあらず見もせぬ人の例ならねバ",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "うら〓〓と春さちめぐる雲かけて野木も花さく時い來おけり",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "あら熊おすがる少女もあはれ也かみを捕へし猛夫のみかい",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "限あらむみちにさきだつ車すら猶ゆるしなく見えける物を",
   "kana": "",
   "speaker": "",
   "page": 218,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  }
 ],
